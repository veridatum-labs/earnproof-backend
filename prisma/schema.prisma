generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  WORKER
  ISSUER
  ADMIN
  DEVELOPER
}

enum ResourceStatus {
  ACTIVE
  PENDING
  SUSPENDED
  REVOKED
  DELETED
}

enum PaymentClassification {
  INCOME
  REIMBURSEMENT
  PERSONAL_TRANSFER
  UNKNOWN
  EXCLUDED
}

enum ProofStatus {
  ACTIVE
  EXPIRED
  REVOKED
  INVALID
}

enum ProofType {
  MINIMUM_INCOME
  RECURRING_INCOME
  PAYMENT_RECEIPT
  INCOME_RANGE
  EMPLOYER_PAYMENT
  EMPLOYMENT_CONTINUITY
  INVOICE_SETTLEMENT
  AGGREGATE_EARNINGS
}

enum AttestationType {
  PAYMENT
  EMPLOYMENT
  INVOICE
}

enum VerificationResult {
  VALID
  EXPIRED
  REVOKED
  INVALID_SIGNATURE
  UNKNOWN_PROOF
  UNVERIFIED_ISSUER
}

model User {
  id                 String          @id @default(cuid())
  walletAddress      String          @unique
  walletHash         String          @unique
  role               UserRole        @default(WORKER)
  status             ResourceStatus  @default(ACTIVE)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  lastLoginAt        DateTime?
  organizations      Organization[]
  payments           Payment[]
  trustedSources     TrustedSource[]
  proofs             Proof[]
  createdApiKeys     ApiKey[]
  auditLogs          AuditLog[]

  @@index([walletHash])
  @@index([status])
}

model WalletChallenge {
  id            String    @id @default(cuid())
  walletAddress String
  nonceHash     String    @unique
  message       String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([walletAddress])
  @@index([expiresAt])
}

model Organization {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  website     String?
  status      ResourceStatus  @default(PENDING)
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  issuers     Issuer[]
  apiKeys     ApiKey[]
  webhooks    Webhook[]

  @@index([status])
}

model Issuer {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id])
  stellarAddress  String          @unique
  status          ResourceStatus  @default(PENDING)
  metadataHash    String?
  verifiedAt      DateTime?
  suspendedAt     DateTime?
  revokedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  trustedSources  TrustedSource[]
  attestations    Attestation[]

  @@index([organizationId])
  @@index([status])
}

model SupportedAsset {
  id          String          @id @default(cuid())
  assetKey    String          @unique
  code        String
  issuer      String?
  network     String
  status      ResourceStatus  @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([network, status])
}

model Payment {
  id                     String                 @id @default(cuid())
  userId                 String
  user                   User                   @relation(fields: [userId], references: [id])
  stellarTransactionHash String
  operationId            String                 @unique
  sourceAddress          String
  destinationAddress     String
  assetCode              String
  assetIssuer            String?
  amountEncrypted        String?
  occurredAt             DateTime
  memo                   String?
  classification         PaymentClassification  @default(UNKNOWN)
  isEligible             Boolean                @default(false)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([userId, occurredAt])
  @@index([sourceAddress])
  @@index([assetCode, assetIssuer])
  @@index([classification])
}

model TrustedSource {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  sourceAddress String
  displayName   String?
  sourceType    String
  issuerId      String?
  issuer        Issuer?         @relation(fields: [issuerId], references: [id])
  status        ResourceStatus  @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([userId, sourceAddress])
  @@index([issuerId])
}

model Proof {
  id                      String              @id @default(cuid())
  userId                  String
  user                    User                @relation(fields: [userId], references: [id])
  proofType               ProofType
  schemaVersion           String
  status                  ProofStatus         @default(ACTIVE)
  network                 String
  assetCode               String
  assetIssuer             String?
  periodStart             DateTime?
  periodEnd               DateTime?
  expiresAt               DateTime
  commitment              String?
  credentialHash          String              @unique
  contractTransactionHash String?
  revokedAt               DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  claim                   ProofClaim?
  verificationEvents      VerificationEvent[]

  @@index([userId, status])
  @@index([proofType])
  @@index([expiresAt])
}

model ProofClaim {
  id                String   @id @default(cuid())
  proofId           String   @unique
  proof             Proof    @relation(fields: [proofId], references: [id])
  operator          String
  thresholdEncrypted String?
  frequency         String?
  result            Boolean
  disclosurePolicy  Json
  createdAt         DateTime @default(now())
}

model Attestation {
  id                   String          @id @default(cuid())
  issuerId             String
  issuer               Issuer          @relation(fields: [issuerId], references: [id])
  subjectWalletHash    String
  paymentReferenceHash String?
  type                 AttestationType
  status               ResourceStatus  @default(ACTIVE)
  signedPayload        Json
  expiresAt            DateTime?
  revokedAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([issuerId, status])
  @@index([subjectWalletHash])
}

model VerificationEvent {
  id                  String             @id @default(cuid())
  proofId             String
  proof               Proof              @relation(fields: [proofId], references: [id])
  verifierFingerprint String?
  result              VerificationResult
  ipHash              String?
  userAgentHash       String?
  createdAt           DateTime           @default(now())

  @@index([proofId, createdAt])
  @@index([result])
}

model ApiKey {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  createdById    String
  createdBy      User            @relation(fields: [createdById], references: [id])
  name           String
  keyHash        String          @unique
  keyPrefix      String
  scopes         String[]
  status         ResourceStatus  @default(ACTIVE)
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime        @default(now())

  @@index([organizationId, status])
  @@index([keyHash])
}

model Webhook {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  url            String
  secretHash     String
  events         Json
  status         ResourceStatus  @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, status])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorType    String
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id])
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorType, actorId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}
